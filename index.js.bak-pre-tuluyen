  console.log(`Bot ${client.user.tag} đã online!`);
  console.log(`Prefix hiện tại: ${data.prefix}`);
  console.log(`Setup: ${data.setupDone ? 'Đã setup' : 'Chưa setup'}`);
  console.log(`Số qtv: ${data.qtv.length}`);
});

